# ── PostgreSQL ───────────────────────────────────────────
PG_DSN=postgresql://navamesh:change_this_password@localhost:5432/navamesh
# Cloud
PG_CLOUD_DSN=postgresql://navamesh:change_this_password@your-cloud-db.postgres.database.azure.com:5432/navamesh?sslmode=require&connect_timeout=5
# ── InfluxDB (local) ────────────────────────────────────
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your_influxdb_token_here
INFLUX_ORG=Your Org Name
INFLUX_BUCKET=farm_data
# ── InfluxDB Cloud ────────────────────────────────────────
INFLUX_CLOUD_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUX_CLOUD_TOKEN=your_cloud_influxdb_token_here
INFLUX_CLOUD_ORG=Your Org Name
INFLUX_CLOUD_BUCKET=your_cloud_bucket
# ── Node metadata ────────────────────────────────────────
# Farm 1: FARM_ID=farm1 and LOCATION_NAME=FAU Garden
# Farm 2: FARM_ID=farm2 and LOCATION_NAME=Spirit Farm
LOCATION_NAME=FAU Garden
NODE_TYPE=field-node
# ── Serial port ─────────────────────────────────────────────
SERIAL_PORT=/dev/ttyACM0
PRIVATE_CHANNEL_INDEX=1
# ── MQTT broker ──────────────────────────────────────────────
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# ── MQTT topic roots ─────────────────────────────────────────
ROOT_RAW=farm/raw
ROOT_SENSORS=farm/sensors
ROOT_NODES=farm/nodes
IGNORED_NODES=
FARM_ID=farm1

#── Reticulum ────────────────────────────────────────────
RNS_CONFIG_DIR=/root/.reticulum
LXMF_STORAGE_DIR=/root/.navamesh_lxmf
LXMF_DISPLAY_NAME=Navamesh Gateway
LXMF_ANNOUNCE_INTERVAL=180
LOG_LEVEL=INFO

#----Map----
# lora = 200px/q35 (~8 KB)  |  halow = 640px/q72 (~120 KB)  |  wifi = 900px/q78 (~220 KB)
MAP_LINK_PROFILE=halow
MAP_MAX_DIMENSION=640
MAP_JPEG_QUALITY=75
MAP_TILE_URL=http://127.0.0.1:8080/tiles/{z}/{x}/{y}.png
MAP_TILE_FALLBACK=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Outlier guardrail — stops one far-away node/cluster from zooming out the farm map.
# Nodes within NEIGHBOR_RADIUS are linked into a mesh (transitively); the largest mesh
# is rendered. A cluster at least SEPARATE_FARM_DISTANCE from it is omitted from the
# plain `map` image (its separation is reported in the text). `map <id>` is never filtered.
MAP_OUTLIER_GUARD_ENABLED=true
MAP_MESH_NEIGHBOR_RADIUS_METERS=800
MAP_OUTLIER_MIN_NODES=3
MAP_SEPARATE_FARM_DISTANCE_METERS=3000

# ── Tile cache (run cache_tiles.py once before shipping) ──────────────────────
# Set these to the farm's bounding box, then run: python3 cache_tiles.py
CACHE_LAT_MIN=
CACHE_LAT_MAX=
CACHE_LON_MIN=
CACHE_LON_MAX=
CACHE_ZOOM_MIN=14
CACHE_ZOOM_MAX=19
