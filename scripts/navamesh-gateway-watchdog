#!/usr/bin/env bash
# navamesh-gateway-watchdog — recover a hung Meshtastic gateway radio.
#
# The RAK4631 gateway has twice stopped delivering packets over USB while still
# enumerated: no USB disconnect, no error from the bridge, which sits holding an
# open port to a dead radio. Observed 2026-08-17 and 2026-08-18.
#
# Toggling the USB device s authorized flag forces a re-enumeration, which
# recovered it both times WITHOUT physical access. That the re-enumeration is
# enough tells us the hang is in the device s USB/CDC-ACM layer rather than the
# whole radio.
#
# It does NOT recover every failure, and the difference matters. On 2026-08-20 the
# RAK answered descriptor reads but failed SET_CONFIGURATION (error -71), then
# stopped accepting a USB address at all. Re-enumeration cannot reach that, so this
# script fired every five minutes for 17 hours and achieved nothing -- while logging
# each time as though it had acted, because it announced success without ever
# checking. Only a physical replug recovered it.
#
# So the toggle is now verified against the thing the bridge actually needs: a
# serial port under /dev/serial/by-id. Present afterwards means recovered; absent
# means this script cannot fix it and someone has to walk to the Pi, which is worth
# saying loudly and exactly once per escalation rather than implying the opposite
# twelve times an hour.
#
# Detection is "no [SENSOR] line in the bridge log for STALE_SECS". That is a
# deliberately conservative signal: it only fires when data has genuinely stopped,
# so a quiet mesh at a long telemetry interval must not trip it -- set STALE_SECS
# comfortably above the slowest expected reporting interval.
set -uo pipefail

STALE_SECS="${STALE_SECS:-900}"      # 15 min. Field nodes report every 8h, but the
                                     # gateway also emits its own telemetry far more
                                     # often, so 15 min of total silence is abnormal.
CONTAINER="${CONTAINER:-navamesh_bridge}"
VENDOR_ID="${VENDOR_ID:-239a}"       # Adafruit/RAK nRF52
LOG_TAG="navamesh-watchdog"
# Serial-port glob the bridge needs to exist. Checked rather than the sysfs device
# dir: the 2026-08-20 failure kept a device directory while never configuring an
# interface, so a directory that exists proves nothing.
TTY_GLOB="${TTY_GLOB:-/dev/serial/by-id/*RAK*}"
# How long to allow for the port to come back. Re-enumeration plus CDC-ACM binding
# is normally a second or two; 20 s is generous rather than fine-tuned.
SETTLE_SECS="${SETTLE_SECS:-20}"
# Consecutive failed recoveries, so an unrecoverable radio can say so instead of
# repeating an identical line every five minutes. /run is tmpfs: a reboot -- which
# is one of the things that fixes this -- should not inherit a stale count.
STATE_FILE="${STATE_FILE:-/run/navamesh-watchdog-failures}"

log() { logger -t "$LOG_TAG" "$*"; echo "$(date -Is) $*"; }
err() { logger -t "$LOG_TAG" -p user.err "$*"; echo "$(date -Is) $*" >&2; }

# shellcheck disable=SC2086  # deliberate: TTY_GLOB must be word-split and globbed
tty_present() { [ -n "$(compgen -G $TTY_GLOB 2>/dev/null)" ]; }

# Any sensor traffic recently? Absence of the container is not our problem to fix.
if ! docker inspect -f "{{.State.Running}}" "$CONTAINER" >/dev/null 2>&1; then
  log "container $CONTAINER not running; nothing to do"
  exit 0
fi

recent=$(docker logs --since "${STALE_SECS}s" "$CONTAINER" 2>&1 | grep -c "\[SENSOR\]" || true)
if [ "${recent:-0}" -gt 0 ]; then
  exit 0
fi

# Find the radio s USB device directory by vendor id.
devpath=""
for d in /sys/bus/usb/devices/*/idVendor; do
  [ -r "$d" ] || continue
  if [ "$(cat "$d" 2>/dev/null)" = "$VENDOR_ID" ]; then devpath="$(dirname "$d")"; break; fi
done
if [ -z "$devpath" ] || [ ! -w "$devpath/authorized" ]; then
  log "no writable USB device for vendor $VENDOR_ID; cannot reset"
  exit 1
fi

log "no sensor traffic in ${STALE_SECS}s -- re-enumerating $(basename "$devpath")"
echo 0 > "$devpath/authorized"; sleep 3
echo 1 > "$devpath/authorized"

# Wait for the port, rather than sleeping a fixed guess and declaring victory.
waited=0
while [ "$waited" -lt "$SETTLE_SECS" ]; do
  if tty_present; then break; fi
  sleep 1
  waited=$((waited + 1))
done

if tty_present; then
  rm -f "$STATE_FILE"
  # The bridge reconnects on its own (10s retry loop), so do not restart it here:
  # restarting would discard its MQTT subscription and buy nothing.
  log "re-enumerated after ${waited}s, serial port is back; bridge will reconnect on its own"
  exit 0
fi

# Re-enumeration did not produce a usable port. This is the failure class the
# toggle cannot fix -- a radio that answers descriptor reads but never configures.
failures=$(( $(cat "$STATE_FILE" 2>/dev/null || echo 0) + 1 ))
echo "$failures" > "$STATE_FILE" 2>/dev/null || true
err "ESCALATE: re-enumeration did not restore a serial port after ${SETTLE_SECS}s" \
    "(consecutive failures: ${failures}). This is not a hung CDC-ACM layer that a" \
    "USB reset can clear -- the radio needs a physical replug or a power cycle." \
    "No further automatic recovery is possible from here."
exit 1
